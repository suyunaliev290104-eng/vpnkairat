# ── Домен бота (A-запись на IP этого сервера). HTTPS выпустится автоматически.
DOMAIN=vpn.example.com
PUBLIC_URL=https://vpn.example.com
WEBAPP_URL=https://vpn.example.com
POSTGRES_PASSWORD=

# ── Telegram
BOT_TOKEN=
BOT_USERNAME=
# JSON-список Telegram ID админов, например [123456789]
ADMIN_IDS=[]
SUPPORT_USERNAME=
BRAND_NAME=VPN

# ── Подписка
TRIAL_DAYS=3
REFERRAL_BONUS_DAYS=7
DEVICE_LIMIT=3

# ── CryptoBot (@CryptoBot → Crypto Pay → Create App). Пусто = способ скрыт.
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=false

# ── lava.top. Пусто = способ скрыт.
LAVATOP_API_KEY=
LAVATOP_WEBHOOK_SECRET=
# ID офферов для каждого тарифа (JSON)
LAVATOP_OFFERS={"m1":"","m3":"","m6":"","m12":""}
